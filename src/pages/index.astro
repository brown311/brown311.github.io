---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CaseStudiesGrid from '../components/CaseStudiesGrid.astro';
import BlueButton from '../components/BlueButton.astro';
---

<BaseLayout title="Home">
	<Hero />
	<CaseStudiesGrid headingTag="h2" />
	<section class="featured-in">
		<h2>Featured In</h2>
		<div class="featured-in-card">
			<div class="featured-in-text">
				<h3>The Benefits Of Cognitive Inclusion In UX Research</h3>
				<p class="subtitle">Smashing Magazine — by Kate Kalcevich</p>
				<p>
					Findings from an exploratory user research study highlighting the unique insights and practical UX
					recommendations shared by participants with cognitive disabilities.
				</p>
				<BlueButton href="https://www.smashingmagazine.com/2026/06/benefits-cognitive-inclusion-ux-research/" external>
					Read the article
				</BlueButton>
			</div>
			<img class="featured-in-logo" src="/images/press/smashing-magazine-logo.png" alt="Smashing Magazine logo" />
		</div>
	</section>
</BaseLayout>

<style>
	.featured-in {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-4) var(--page-gutter);
		background: var(--color-bg);
	}

	.featured-in h2 {
		color: var(--color-text-on-dark);
	}

	.featured-in-card {
		display: flex;
		align-items: center;
		gap: var(--space-5);
	}

	.featured-in-text {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding: var(--space-3) 0 var(--space-3) var(--space-4);
		border-left: 5px solid var(--color-accent-yellow);
		color: var(--color-text-on-dark);
	}

	.featured-in-text .subtitle {
		font-weight: var(--text-body-weight-bold);
	}

	.featured-in-logo {
		width: 120px;
		height: 120px;
		flex-shrink: 0;
		object-fit: contain;
	}

	@media (max-width: 700px) {
		.featured-in-card {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
