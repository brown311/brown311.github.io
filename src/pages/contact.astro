---
import BaseLayout from '../layouts/BaseLayout.astro';

const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xzebkkpk';
---

<BaseLayout title="Contact" description="Get in touch with Ali Brown.">
	<!-- Full-width band carries the background; .page holds the 50% content column. -->
	<section class="page-bg">
		<div class="page">
			<h1>Contact</h1>
			<h3>Let&rsquo;s connect!</h3>

			<form id="contact-form" method="POST" action={FORMSPREE_ENDPOINT} novalidate>
				<div class="field">
					<label for="first-name">First Name <span class="required-hint">(required)</span></label>
					<input type="text" id="first-name" name="first_name" required />
				</div>

				<div class="field">
					<label for="last-name">Last Name <span class="required-hint">(required)</span></label>
					<input type="text" id="last-name" name="last_name" required />
				</div>

				<div class="field">
					<label for="email">Email <span class="required-hint">(required)</span></label>
					<input type="email" id="email" name="email" required />
				</div>

				<div class="field">
					<label for="message">Message <span class="required-hint">(required)</span></label>
					<textarea id="message" name="message" rows="6" required></textarea>
				</div>

				<!-- Honeypot spam trap — hidden from real users, bots tend to fill every field -->
				<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="honeypot" />

				<button type="submit" class="submit-button">Send</button>

				<p id="form-status" role="status" aria-live="polite"></p>
			</form>

			<dialog id="success-dialog" class="success-dialog">
				<button type="button" class="success-dialog-x" aria-label="Close">&times;</button>
				<p>Your message was sent! I look forward to connecting soon.</p>
				<button type="button" class="success-dialog-close">Close</button>
			</dialog>
		</div>
	</section>
</BaseLayout>

<style>
	.page-bg {
		background: var(--color-accent-sky);
		color: var(--color-text-on-light);
	}

	.page {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-5) 0;
		margin-left: var(--page-gutter);
		width: 50%;
	}

	form {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	label {
		font-weight: var(--text-body-weight-bold);
	}

	.required-hint {
		font-weight: var(--text-body-weight-regular);
	}

	input,
	textarea {
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--color-dark);
		border-radius: 10px;
		background: var(--color-light);
		color: var(--color-text-on-light);
		font-family: var(--font-sans);
		font-size: var(--text-body-size);
	}

	/* Hover and focus thicken the border to 2px. Padding drops by the same 1px
	   so the field doesn't grow and nudge the layout. */
	input:hover,
	textarea:hover,
	input:focus-visible,
	textarea:focus-visible {
		border-width: 2px;
		padding: calc(var(--space-2) - 1px) calc(var(--space-3) - 1px);
	}

	input:focus-visible,
	textarea:focus-visible {
		border-color: var(--color-dark);
		/* Dark, not yellow — this ring sits on the sky-blue page background,
		   where yellow would be ~1.6:1 and effectively invisible. */
		outline: 2px dashed var(--color-dark);
		outline-offset: 2px;
	}

	.field.has-error input,
	.field.has-error textarea {
		border-color: var(--color-error);
	}

	.field.has-error input:hover,
	.field.has-error textarea:hover {
		border-color: var(--color-dark);
	}

	/* :global — these elements are created dynamically in the <script> below,
	   so they never receive Astro's scoped data-attribute and scoped rules
	   would silently fail to match them. */
	:global(.field-error) {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin: 0;
		color: var(--color-error);
		font-weight: var(--text-body-weight-bold);
		font-size: var(--text-body-size);
	}

	:global(.error-icon) {
		width: 24px;
		height: 24px;
		flex-shrink: 0;
	}

	.honeypot {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.submit-button {
		align-self: flex-start;
		padding: 0.75rem var(--space-4);
		border: 2px solid transparent;
		border-radius: 30px;
		outline: none;
		background: var(--color-dark);
		color: var(--color-light);
		font-weight: var(--text-body-weight-bold);
		font-size: var(--text-body-size);
		font-family: var(--font-sans);
		cursor: pointer;
	}

	/* Same invert-on-hover as the Black Button used on case study cards. */
	.submit-button:hover {
		background: var(--color-light);
		border-color: var(--color-dark);
		color: var(--color-dark);
	}

	.submit-button:focus-visible {
		outline: 2px dashed var(--color-dark);
		outline-offset: 4px;
	}

	.submit-button:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	#form-status {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin: 0;
		font-weight: var(--text-body-weight-bold);
	}

	#form-status:empty {
		display: none;
	}

	#form-status.error {
		color: var(--color-error);
	}

	@media (max-width: 800px) {
		.page {
			width: 100%;
			margin-left: 0;
			padding: var(--space-5) var(--space-4);
		}
	}

	/* Pinned to the viewport centre, not the document — otherwise it renders
	   wherever it sits in the flow and scrolls away with the page. `fixed`
	   also gives the absolutely-positioned close X its containing block. */
	.success-dialog {
		position: fixed;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		margin: 0;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-5);
		border: none;
		border-radius: 10px;
		background: var(--color-light);
		color: var(--color-text-on-light);
		width: max-content;
		max-width: min(28rem, calc(100vw - 2rem));
	}

	/* Only flex-laid-out (and visible) once actually opened — without this
	   scoping, the unconditional display:flex above would override the
	   browser's default dialog:not([open]) { display: none } and leave the
	   dialog permanently visible in the page flow. */
	.success-dialog[open] {
		display: flex;
	}

	.success-dialog::backdrop {
		background: rgba(0, 0, 0, 0.9);
	}

	.success-dialog p {
		margin: 0;
		padding-right: var(--space-5);
		font-size: var(--text-h4-size);
		font-weight: var(--text-body-weight-bold);
	}

	/* Same hover/focus pattern as the square nav buttons (fill-invert on
	   hover, dashed outline on focus), adapted to this dialog's light bg. */
	.success-dialog-x {
		position: absolute;
		top: var(--space-3);
		right: var(--space-3);
		padding: 0 var(--space-2);
		border: 2px solid transparent;
		border-radius: 0;
		outline: none;
		background: none;
		color: var(--color-text-on-light);
		font-size: var(--text-h3-size);
		line-height: 1.6;
		font-family: var(--font-sans);
		cursor: pointer;
	}

	.success-dialog-x:hover {
		background: var(--color-dark);
		border-color: var(--color-dark);
		color: var(--color-light);
	}

	.success-dialog-x:focus-visible {
		outline: 2px dashed var(--color-dark);
		outline-offset: 4px;
	}

	.success-dialog-close {
		align-self: flex-start;
		padding: 0.75rem var(--space-4);
		border: 2px solid transparent;
		border-radius: 30px;
		outline: none;
		background: var(--color-dark);
		color: var(--color-light);
		font-weight: var(--text-body-weight-bold);
		font-size: var(--text-body-size);
		font-family: var(--font-sans);
		cursor: pointer;
	}

	.success-dialog-close:hover {
		background: var(--color-light);
		border-color: var(--color-dark);
		color: var(--color-text-on-light);
	}

	.success-dialog-close:focus-visible {
		outline: 2px dashed var(--color-dark);
		outline-offset: 4px;
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>('#contact-form');
	const status = document.querySelector<HTMLParagraphElement>('#form-status');
	const submitButton = form?.querySelector<HTMLButtonElement>('.submit-button');
	const fields = form ? Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')) : [];
	const successDialog = document.querySelector<HTMLDialogElement>('#success-dialog');

	successDialog?.querySelector('.success-dialog-close')?.addEventListener('click', () => successDialog.close());
	successDialog?.querySelector('.success-dialog-x')?.addEventListener('click', () => successDialog.close());

	// Only the two explicit close controls above should dismiss this dialog —
	// clicking the backdrop, or pressing Escape, should not.
	successDialog?.addEventListener('cancel', (event) => event.preventDefault());

	// showModal() blocks interaction with the page behind, but not scrolling —
	// lock the body while it's open. Hooked to the native `close` event so the
	// lock lifts no matter which control dismissed it.
	function lockScroll() {
		document.body.style.overflow = 'hidden';
	}

	successDialog?.addEventListener('close', () => {
		document.body.style.overflow = '';
	});

	function errorIcon(): HTMLImageElement {
		const icon = document.createElement('img');
		icon.src = '/icons/exclamation-circle.svg';
		icon.alt = '';
		icon.setAttribute('aria-hidden', 'true');
		icon.className = 'error-icon';
		return icon;
	}

	function setStatus(text: string, isError: boolean) {
		if (!status) return;
		status.classList.toggle('error', isError);
		status.replaceChildren(...(isError ? [errorIcon()] : []), document.createTextNode(text));
	}

	function clearFieldError(field: HTMLInputElement | HTMLTextAreaElement) {
		field.closest('.field')?.classList.remove('has-error');
		field.closest('.field')?.querySelector('.field-error')?.remove();
	}

	function showFieldError(field: HTMLInputElement | HTMLTextAreaElement) {
		clearFieldError(field);
		if (field.validity.valid) return;

		const wrapper = field.closest('.field');
		if (!wrapper) return;

		wrapper.classList.add('has-error');
		const message = document.createElement('p');
		message.className = 'field-error';
		const text = field.validity.valueMissing
			? 'This field is required.'
			: field.validity.typeMismatch
				? 'Please enter a valid email address.'
				: 'Please check this field.';
		message.append(errorIcon(), document.createTextNode(text));
		wrapper.appendChild(message);
	}

	// Show an error as soon as the user leaves a field they interacted with
	// and left empty/invalid, rather than waiting until they hit submit.
	fields.forEach((field) => {
		field.addEventListener('blur', () => showFieldError(field));
		field.addEventListener('input', () => {
			if (field.validity.valid) clearFieldError(field);
		});
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!status || !submitButton || !form) return;

		if (!form.checkValidity()) {
			let firstInvalid: HTMLElement | null = null;
			fields.forEach((field) => {
				showFieldError(field);
				if (!field.validity.valid) firstInvalid ??= field;
			});
			firstInvalid?.focus();

			setStatus('Please fill out all required fields before sending.', true);
			return;
		}

		fields.forEach(clearFieldError);

		submitButton.disabled = true;
		setStatus('Sending…', false);

		try {
			const response = await fetch(form.action, {
				method: 'POST',
				body: new FormData(form),
				headers: { Accept: 'application/json' },
			});

			if (response.ok) {
				status.classList.remove('error');
				status.replaceChildren();
				successDialog?.showModal();
				lockScroll();
				form.reset();
			} else {
				setStatus('Something went wrong. Please try again or email me directly.', true);
			}
		} catch {
			setStatus('Something went wrong. Please try again or email me directly.', true);
		} finally {
			submitButton.disabled = false;
		}
	});
</script>
