---
import BlueButton from './BlueButton.astro';

const currentPath = Astro.url.pathname;

const navItems = [
	{ href: '/', label: 'Work' },
	{ href: '/about', label: 'About' },
];

function isActive(href: string) {
	if (href === '/') return currentPath === '/';
	return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header">
	<a class="wordmark" href="/">Ali&rsquo;s Portfolio</a>

	<button type="button" class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="site-nav">
		<span class="menu-icon" aria-hidden="true"></span>
		<span class="sr-only">Menu</span>
	</button>

	<nav id="site-nav">
		<ul>
			{
				navItems.map((item) => (
					<li>
						<a class:list={['nav-btn', { 'is-active': isActive(item.href) }]} href={item.href}>
							{item.label}
						</a>
					</li>
				))
			}
			<li>
				<a class="nav-btn" href="https://www.linkedin.com/in/ali-brown-971836146/" target="_blank" rel="noopener noreferrer">
					LinkedIn
					<img src="/icons/arrow-up-right-square.svg" alt="" aria-hidden="true" />
					<span class="sr-only">(opens in new tab)</span>
				</a>
			</li>
			<li><BlueButton href="/contact">Contact</BlueButton></li>
		</ul>
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--space-5) var(--page-gutter);
		border-bottom: 2px solid var(--color-light);
		background: var(--color-bg);
	}

	.wordmark {
		padding: 0.75rem var(--space-4);
		border: 2px solid transparent;
		outline: none;
		color: var(--color-text-on-dark);
		text-decoration: none;
		font-size: var(--text-h2-size);
		font-weight: var(--text-h2-weight);
	}

	.wordmark:hover {
		border-color: var(--color-light);
	}

	.wordmark:focus-visible {
		outline: 2px dashed var(--color-light);
		outline-offset: 4px;
	}

	/* ---------- Hamburger toggle: hidden on desktop, shown under 900px ---------- */

	.menu-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 2px solid transparent;
		outline: none;
		background: none;
		cursor: pointer;
	}

	.menu-toggle:hover {
		border-color: var(--color-light);
	}

	.menu-toggle:focus-visible {
		outline: 2px dashed var(--color-light);
		outline-offset: 4px;
	}

	/* Three bars that collapse into an X when open — no icon asset needed. */
	.menu-icon,
	.menu-icon::before,
	.menu-icon::after {
		display: block;
		width: 24px;
		height: 2px;
		background: var(--color-light);
		transition:
			transform 0.15s ease,
			opacity 0.15s ease;
	}

	.menu-icon::before,
	.menu-icon::after {
		content: '';
		position: relative;
	}

	.menu-icon::before {
		top: -7px;
	}

	.menu-icon::after {
		top: -9px;
	}

	.menu-toggle[aria-expanded='true'] .menu-icon {
		background: transparent;
	}

	.menu-toggle[aria-expanded='true'] .menu-icon::before {
		top: 0;
		transform: rotate(45deg);
	}

	.menu-toggle[aria-expanded='true'] .menu-icon::after {
		top: -2px;
		transform: rotate(-45deg);
	}

	/* ---------- Nav ---------- */

	nav > ul {
		display: flex;
		gap: var(--space-3);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		padding: 0.75rem var(--space-4); /* 12px vertical per Figma spec — outside the 4/8/16px scale */
		border: 2px solid transparent;
		border-radius: 0;
		outline: none;
		background: transparent;
		color: var(--color-text-on-dark);
		font-weight: var(--text-body-weight-bold);
		font-size: var(--text-body-size);
		font-family: inherit;
		text-decoration: none;
	}

	.nav-btn img {
		width: 24px;
		height: 24px;
	}

	/* Mouse hover: fills white with black text (border matches bg, so it's
	   invisible on its own — it only matters once focus adds the dashed ring). */
	.nav-btn:hover {
		background: var(--color-light);
		border-color: var(--color-light);
		color: var(--color-text-on-light);
	}

	/* Icon is a solid white SVG; inverting it flips it to match the black text. */
	.nav-btn:hover img {
		filter: invert(1);
	}

	/* Keyboard focus: same dashed-ring-with-gap treatment as every other
	   button (Blue/Black), so the focus indicator reads consistently
	   everywhere. Works whether or not :hover is also active. */
	.nav-btn:focus-visible {
		outline: 2px dashed var(--color-light);
		outline-offset: 4px;
	}

	/* Current-page indicator — not a Figma interaction state, kept distinct
	   from :hover/:focus-visible above so it doesn't inherit the fill/invert. */
	.nav-btn.is-active {
		border-style: solid;
		border-color: var(--color-light);
	}

	/* ---------- Mobile: collapse nav into a toggleable panel ---------- */

	@media (max-width: 900px) {
		.menu-toggle {
			display: inline-flex;
		}

		nav {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: var(--color-bg);
			border-bottom: 2px solid var(--color-light);
		}

		nav:not(.is-open) {
			display: none;
		}

		nav > ul {
			flex-direction: column;
			gap: var(--space-2);
			padding: var(--space-3) var(--page-gutter) var(--space-4);
		}

		.nav-btn {
			width: 100%;
			justify-content: flex-start;
		}

		.site-header {
			position: relative;
		}
	}
</style>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
	const nav = document.querySelector<HTMLElement>('#site-nav');

	function closeMenu() {
		if (!toggle || !nav) return;
		toggle.setAttribute('aria-expanded', 'false');
		nav.classList.remove('is-open');
	}

	function openMenu() {
		if (!toggle || !nav) return;
		toggle.setAttribute('aria-expanded', 'true');
		nav.classList.add('is-open');
	}

	toggle?.addEventListener('click', () => {
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		if (isOpen) closeMenu();
		else openMenu();
	});

	// Tapping a nav link closes the panel rather than leaving it open behind
	// the page that just navigated.
	nav?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => closeMenu());
	});

	document.addEventListener('click', (event) => {
		if (!toggle || !nav) return;
		const target = event.target as Node;
		if (!toggle.contains(target) && !nav.contains(target)) closeMenu();
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			closeMenu();
			toggle?.focus();
		}
	});

	// If the viewport grows past the mobile breakpoint while the panel is
	// open (e.g. rotating a tablet), don't leave it stuck open.
	const mobileQuery = window.matchMedia('(max-width: 900px)');
	mobileQuery.addEventListener('change', (event) => {
		if (!event.matches) closeMenu();
	});
</script>
