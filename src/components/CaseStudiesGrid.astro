---
import { getCollection } from 'astro:content';
import CaseStudyCard from './CaseStudyCard.astro';

interface Props {
	headingTag?: 'h1' | 'h2';
}

const { headingTag: HeadingTag = 'h2' } = Astro.props;

const caseStudies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
---

<section class="work" id="featured-work">
	<HeadingTag>Featured Work</HeadingTag>
	<div class="work-grid">
		{
			caseStudies.map((entry) => (
				<CaseStudyCard
					slug={entry.id}
					title={entry.data.title}
					summary={entry.data.summary}
					category={entry.data.category}
					year={entry.data.year}
					ctaLabel={entry.data.ctaLabel}
					coverImage={entry.data.coverImage}
					comingSoon={entry.data.comingSoon}
				/>
			))
		}
	</div>
</section>

<style>
	.work {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-4) var(--page-gutter);
		background: var(--color-bg);
	}

	.work :global(h1),
	.work :global(h2) {
		color: var(--color-text-on-dark);
	}

	.work-grid {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}
</style>
