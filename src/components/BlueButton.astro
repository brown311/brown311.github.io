---
interface Props {
	href: string;
	external?: boolean;
}

const { href, external = false } = Astro.props;
---

<a class="blue-button" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
	<slot />
	{
		external && (
			<Fragment>
				<svg class="blue-button-icon" viewBox="0 0 100 100" fill="none" aria-hidden="true">
					<path
						fill-rule="evenodd"
						clip-rule="evenodd"
						d="M93.75 12.5C93.75 10.8424 93.0915 9.25268 91.9194 8.08058C90.7473 6.90848 89.1576 6.25 87.5 6.25H12.5C10.8424 6.25 9.25268 6.90848 8.08058 8.08058C6.90848 9.25268 6.25 10.8424 6.25 12.5V87.5C6.25 89.1576 6.90848 90.7473 8.08058 91.9194C9.25268 93.0915 10.8424 93.75 12.5 93.75H87.5C89.1576 93.75 90.7473 93.0915 91.9194 91.9194C93.0915 90.7473 93.75 89.1576 93.75 87.5V12.5ZM0 12.5C0 9.18479 1.31696 6.00537 3.66117 3.66117C6.00537 1.31696 9.18479 0 12.5 0L87.5 0C90.8152 0 93.9946 1.31696 96.3388 3.66117C98.683 6.00537 100 9.18479 100 12.5V87.5C100 90.8152 98.683 93.9946 96.3388 96.3388C93.9946 98.683 90.8152 100 87.5 100H12.5C9.18479 100 6.00537 98.683 3.66117 96.3388C1.31696 93.9946 0 90.8152 0 87.5V12.5ZM36.5875 67.5188C36.0015 68.1055 35.2065 68.4355 34.3772 68.4361C33.5479 68.4367 32.7524 68.1078 32.1656 67.5219C31.5788 66.9359 31.2488 66.1408 31.2483 65.3116C31.2477 64.4823 31.5765 63.6868 32.1625 63.1L57.7688 37.5H40.4687C39.6399 37.5 38.8451 37.1708 38.259 36.5847C37.673 35.9987 37.3437 35.2038 37.3437 34.375C37.3437 33.5462 37.673 32.7513 38.259 32.1653C38.8451 31.5792 39.6399 31.25 40.4687 31.25H65.3125C66.1413 31.25 66.9362 31.5792 67.5222 32.1653C68.1083 32.7513 68.4375 33.5462 68.4375 34.375V59.2188C68.4375 60.0476 68.1083 60.8424 67.5222 61.4285C66.9362 62.0145 66.1413 62.3438 65.3125 62.3438C64.4837 62.3438 63.6888 62.0145 63.1028 61.4285C62.5167 60.8424 62.1875 60.0476 62.1875 59.2188V41.9187L36.5875 67.5188Z"
						fill="currentColor"
					/>
				</svg>
				<span class="sr-only">(opens in new tab)</span>
			</Fragment>
		)
	}
</a>

<style>
	.blue-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		align-self: flex-start;
		gap: var(--space-2);
		padding: 0.75rem var(--space-4); /* 12px vertical per Figma spec — outside the 4/8/16px scale */
		border: 2px solid transparent;
		border-radius: 30px;
		outline: none;
		background: var(--color-accent-sky);
		color: var(--color-text-on-light);
		font-weight: var(--text-body-weight-bold);
		font-size: var(--text-body-size);
		text-decoration: none;
	}

	/* Mouse hover: pill inverts to dark bg with a sky border + sky text. */
	.blue-button:hover {
		background: var(--color-dark);
		border-color: var(--color-accent-sky);
		color: var(--color-accent-sky);
	}

	/* Keyboard focus: dashed ring with a 4px gap — same treatment as every
	   other button in the design system. */
	.blue-button:focus-visible {
		outline: 2px dashed var(--color-accent-sky);
		outline-offset: 4px;
	}

	/* Hover + focus together: ring becomes solid (pill colors come from :hover above). */
	.blue-button:hover:focus-visible {
		outline-style: solid;
	}

	.blue-button-icon {
		width: 24px;
		height: 24px;
	}
</style>
