---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<ul class="footer-links">
		<li><a href="/contact">Contact</a></li>
		<li>
			<a href="https://www.linkedin.com/in/ali-brown-971836146/" target="_blank" rel="noopener noreferrer">
				<img src="/icons/linkedin.svg" alt="" aria-hidden="true" />
				LinkedIn
				<span class="sr-only">(opens in new tab)</span>
			</a>
		</li>
	</ul>
	<p>&copy; {year} Ali Brown</p>
</footer>

<style>
	.site-footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		margin-top: var(--space-6);
		padding: var(--space-4) var(--page-gutter);
		border-top: 2px solid var(--color-light);
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.footer-links a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) 4px;
		border: 2px solid transparent;
		outline: none;
		color: inherit;
		text-decoration: none;
	}

	.footer-links img {
		width: 24px;
		height: 24px;
	}

	.footer-links a:hover {
		border-color: var(--color-light);
	}

	.footer-links a:focus-visible {
		outline: 2px dashed var(--color-light);
		outline-offset: 4px;
	}
</style>
