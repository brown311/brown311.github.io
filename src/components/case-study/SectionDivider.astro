---
interface Props {
	title: string;
	id?: string;
}

const { title, id } = Astro.props;
---

<div class="section-divider" id={id}>
	<h2>{title}</h2>
</div>

<style>
	.section-divider {
		padding: var(--space-4) var(--page-gutter);
		padding-top: var(--space-6); /* 64px */
		background: var(--color-bg);
		border-bottom: 5px solid var(--color-accent-yellow);
	}

	h2 {
		font-size: 3rem; /* 48px per Figma spec — outside the h1/h2 scale */
		color: var(--color-text-on-dark);
	}
</style>
