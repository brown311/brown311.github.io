---
interface Props {
	title: string;
	summary: string;
	meta?: { label: string; value: string }[];
}

const { title, summary, meta = [] } = Astro.props;
---

<header class="hero">
	<div class="hero-text">
		<h1>{title}</h1>
		<blockquote class="pull-quote">{summary}</blockquote>
		{
			meta.length > 0 && (
				<dl class="meta-list">
					{meta.map((item) => (
						<div>
							<dt>{item.label}:</dt>
							<dd>{item.value}</dd>
						</div>
					))}
				</dl>
			)
		}
	</div>
	<div class="hero-media">
		<slot name="media" />
	</div>
</header>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: var(--space-5);
		align-items: center;
		padding: var(--space-4) var(--page-gutter);
		background: var(--color-light);
		color: var(--color-text-on-light);
	}

	.hero-text {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.pull-quote {
		margin: 0;
		padding: var(--space-3) 0 var(--space-3) var(--space-4);
		border-left: 5px solid var(--color-accent-orange);
		font-size: var(--text-h3-size);
	}

	.meta-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		margin: 0;
	}

	.meta-list div {
		display: flex;
		gap: var(--space-1);
	}

	.meta-list dt {
		font-weight: var(--text-body-weight-bold);
	}

	.meta-list dd {
		margin: 0;
	}

	.hero-media :global(img),
	.hero-media :global(video) {
		max-width: 100%;
		max-height: 32rem;
		object-fit: contain;
		border-radius: 10px;
	}

	@media (max-width: 800px) {
		.hero {
			grid-template-columns: 1fr;
		}
	}
</style>
